    {
      "cell_type": "code",
      "source": [
        "data_augmentation = tf.keras.Sequential([\n",
        "    layers.RandomFlip(\"horizontal\"),\n",
        "    layers.RandomRotation(0.15),\n",
        "    layers.RandomZoom(0.15),\n",
        "    layers.RandomTranslation(0.1, 0.1)\n",
        "])"
      ],
      "metadata": {
        "id": "kYlqMnEtpO4l"
